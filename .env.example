# Google Gemini API Key (Required)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_api_key_here

# Gemini Model to use for translation (Default: gemini-2.5-pro for best literary quality)
# Options:
# - gemini-2.5-pro   (Best quality, rich literary vocabulary, natural dialogue - Recommended)
# - gemini-1.5-pro   (Deep reasoning, long-context consistency for complex books)
# - gemini-2.5-flash (Fast & economical - balanced)
# - gemini-2.0-flash (Ultra fast)
GEMINI_MODEL=gemini-2.5-pro

# Maximum concurrent batch translations to prevent hitting rate limits
MAX_CONCURRENT_TRANSLATIONS=2
