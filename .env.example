# Google Gemini API Key (Required)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_api_key_here

# Gemini Model to use for translation (Default: gemini-3.8-flash)
# Options:
# Frontier / High-End:
# - gemini-3.8-flash     (Tercerdas untuk alur kerja kompleks, agen & sastra - Recommended)
# - gemini-3.7-flash     (Andal untuk coding & eksekusi multi-langkah presisi)
# - gemini-3.6-flash     (Menyeimbangkan kecepatan kilat & multimodal)
# - gemini-3.5-flash     (Kecepatan dasar & performa rutin)
# Super Hemat Kuota:
# - gemini-2.5-flash-lite (Paling hemat kuota & tercepat di kelasnya)
# Classic:
# - gemini-1.5-pro       (Kualitas sastra klasik, pemahaman dialog novel)
# - gemini-2.0-flash     (Generasi 2.0 Kilat)
# - gemini-1.5-flash     (Klasik sangat stabil)
GEMINI_MODEL=gemini-3.8-flash

# Maximum concurrent batch translations to prevent hitting rate limits
MAX_CONCURRENT_TRANSLATIONS=2
