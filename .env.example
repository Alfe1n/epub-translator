# Google Gemini API Key (Required)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_api_key_here

# Gemini Model to use for translation (Default: gemini-1.5-pro for best literary quality)
# Options:
# - gemini-1.5-pro   (Best quality, rich literary vocabulary, natural dialogue - Recommended)
# - gemini-2.0-flash (Ultra fast & modern)
# - gemini-1.5-flash (Fast, rock-solid & economical)
# - gemini-2.5-flash (Version 2.5 Flash)
GEMINI_MODEL=gemini-1.5-pro

# Maximum concurrent batch translations to prevent hitting rate limits
MAX_CONCURRENT_TRANSLATIONS=2
